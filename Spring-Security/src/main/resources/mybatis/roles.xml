<?xml version = "1.0" encoding = "UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.springsecurity.mappers.IRoleMapper">

    <select id="findByRoleCode" resultType="string">
        SELECT R.ROLE_ID FROM ROLES R WHERE R.ROLE_CODE IN
        <foreach item="roleCode" collection="roleCodes" open="(" separator="," close=")">
            #{roleCode}
        </foreach>
        AND R.ENABLED = TRUE
    </select>

    <insert id="insertUserRole">
        INSERT INTO USER_ROLES (USER_ID, ROLE_ID)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <select id="findRoleByUserId" resultType="string">
        SELECT R.ROLE_CODE
        FROM USER_ROLES U
                 INNER JOIN ROLES R ON U.ROLE_ID = R.ROLE_ID
        WHERE U.USER_ID = #{userId}
          AND U.ENABLED = TRUE
          AND R.ENABLED = TRUE
    </select>

</mapper>